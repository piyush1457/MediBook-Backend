# --- App ---
APP_NAME=EVE Healthcare
ENV=dev
API_PREFIX=/api/v1

# --- Database ---
# Docker compose uses this; local dev override in .env
DATABASE_URL=postgresql+psycopg2://eve:evepass@db:5432/eve
# Tests use this if set, else fall back to SQLite (identical behaviour for tested rules)
TEST_DATABASE_URL=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Webhook ---
WEBHOOK_SECRET=change-me-webhook-secret

# --- Seed admin ---
ADMIN_EMAIL=admin@eve.local
ADMIN_PASSWORD=Adminpass123
ADMIN_NAME=Admin

# --- Misc ---
LOG_LEVEL=INFO
